---

---

<header>
  <nav>
    <a href="/" class="logo">
      <span class="logo-icon">👣</span>
      <span class="logo-text">Tiny Steps</span>
    </a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#how-it-works">How It Works</a>
      <a href="#why">Why Tiny Steps</a>
    </div>
    <a href="#cta" class="nav-cta">Get Started</a>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(250, 250, 249, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stone-200);
  }

  nav {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--stone-800);
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .logo-text {
    font-weight: 700;
    font-size: 1.125rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--stone-500);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--stone-800);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    background: var(--amber-500);
    color: white;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.2s, transform 0.1s;
  }

  .nav-cta:hover {
    background: var(--amber-600);
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
  }
</style>
